node_modules/
.codex

# These are the exact runtime files for Joplin development-plugin installs and
# the installable package. They are intentionally versioned so a git pull gets
# the same validated build; other generated output remains ignored.
dist/*
!dist/index.js
!dist/manifest.json
!dist/panel.css
!dist/panel.js
publish/*
!publish/net.sverd.subPages.jpl

# Generated UAT/debug artifacts. Keep the browser smoke harness tracked.
artifacts/*
!artifacts/
!artifacts/cdp-panel-smoke.mjs
!artifacts/joplin-desktop-uat.mjs
!artifacts/panel-harness.html
