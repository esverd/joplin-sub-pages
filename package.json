{
  "name": "joplin-plugin-sub-pages",
  "version": "1.0.0",
  "description": "Adds a notebook-scoped parent and child page tree panel to Joplin.",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=createArchive",
    "test": "npm run typecheck",
    "test:panel": "node artifacts/cdp-panel-smoke.mjs",
    "test:uat": "node artifacts/joplin-desktop-uat.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin",
    "productivity",
    "personal knowledge management",
    "notes"
  ],
  "files": [
    "publish"
  ],
  "devDependencies": {
    "@types/node": "^18.7.13",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "tar": "^6.1.11",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  }
}
